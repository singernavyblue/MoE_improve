#!/usr/bin/expect -f
# Usage: scp_from.exp <host> <port> <password> <remote-src> <local-dst>
set timeout 600
set host [lindex $argv 0]
set port [lindex $argv 1]
set pw   [lindex $argv 2]
set src  [lindex $argv 3]
set dst  [lindex $argv 4]
spawn scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=20 -P $port root@$host:$src $dst
expect {
    -re "assword:" { send -- "$pw\r"; exp_continue }
    -re "yes/no" { send -- "yes\r"; exp_continue }
    eof
}
catch wait result
exit [lindex $result 3]
