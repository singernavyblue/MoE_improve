#!/usr/bin/expect -f
# Usage: scp_from_host.exp <host> <port> <password> <remote_src> <local_dst>
set timeout 120
set host [lindex $argv 0]
set port [lindex $argv 1]
set password [lindex $argv 2]
set src [lindex $argv 3]
set dst [lindex $argv 4]
spawn scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -P $port root@$host:$src $dst
expect {
  "password:" { send "$password\r"; exp_continue }
  eof
}
